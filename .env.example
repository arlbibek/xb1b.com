# Cloudflare Turnstile: create a Managed widget allowing xb1b.com.
# Public site key is embedded at build time; rebuild after changing it.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# Server only. Never prefix the secret with NEXT_PUBLIC_.
TURNSTILE_SECRET_KEY=
# Exact allowed widget hostnames, comma-separated, without protocol or port.
TURNSTILE_HOSTNAMES=xb1b.com
